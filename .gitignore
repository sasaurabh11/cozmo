.venv/
.venv-recon/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
dist/
build/
out/
runs/
weights/
# Fitted by `cozmo calibrate` against whatever benchmark captures and ground
# truth happen to be on this machine -- a fit from a thin or synthetic set is
# not a number worth committing, and the pipeline runs uncalibrated (factor
# 1.0 everywhere) and says so when this file is absent.
calibration/
.DS_Store

# Raw captures and run outputs live outside version control. The leading slash
# matters: without it this would also swallow tests/fixtures/captures/, which is
# committed on purpose.
/captures/
/results/

# Capture fixtures are generated by tests/fixtures/{generate,synthesize}.py in
# a fraction of a second, and pytest rebuilds them automatically. Committing
# 472 KB of depth PNGs and MP4s would only let them drift from the generators.
tests/fixtures/captures/
